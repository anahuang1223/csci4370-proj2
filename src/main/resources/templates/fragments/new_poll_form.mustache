<div class="container framed">
    <div class="post-form">
        <form method="post" action="/createpoll">
            <h3>Poll Question:</h3>
            <textarea name="question" class="framed" placeholder="Post your question here" required></textarea>
            
            <h3>Choice 1:</h3>
            <textarea name="choice1" class="framed" placeholder="Enter Choice 1:" required></textarea>
            
            <h3>Choice 2:</h3>
            <textarea name="choice2" class="framed" placeholder="Enter Choice 2:" required></textarea>
            
            <button type="submit" class="action-button">Create Poll</button>
        </form>
        <div class="clear"></div>
    </div>
</div>